# Optional overrides for the root local Compose setup. Local use only.
# Defaults allow startup without creating .env.
APP_PORT=8080
SECRET_KEY=local-only-not-for-deployment-change-me
POSTGRES_DB=subscriptionguard
POSTGRES_USER=subscriptionguard
POSTGRES_PASSWORD=local-only-password

# Development-only browser auto-login; run seed_local first.
# These values are visible in browser code; never use real credentials.
LOCAL_API_USERNAME=demo
LOCAL_API_PASSWORD=local-demo-password
