# Use the local Django API instead of generated development subscriptions.
# The backend docker-compose exposes its API on localhost:8001.
VITE_USE_MOCK_REPOSITORIES=false

# Optional local-only credentials. When set in development, the frontend logs
# in automatically and re-authenticates after an expired access token.
VITE_DEV_API_USERNAME=
VITE_DEV_API_PASSWORD=
